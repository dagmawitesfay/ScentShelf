<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfume</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/75136afa19.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Headeer -->
        <header>
            <div class="title">
            <h1>Scent <em>Shelf</em></h1>
            </div>
        <div class="length-container">
            <p><%= perfumes.length %> fragrances</p>
        </div>
    </header> 
    <!-- Perfume Collection -->
       <main class="main-wrapper">

    <section class="form-container">
      <form action="/perfume" method="post">
        <h3>Add a <em>fragrance</em></h3>
        <p>Log a new bottlw to your shelf</p>

        <!-- Image Section -->
        <div class="field">
          <label for="name">Image URL </label>
          <input type="text" name="image" id="image" required placeholder="https://"/>
        </div>

           <!-- Name Section -->
        <div class="field">
          <label for="name">Name </label>
          <input type="text" name="name" id="name" required placeholder="Sauvage"/>
        </div>

            <!-- Brand -->
        <div class="field">
          <label for="name">Brand </label>
          <input type="text" name="brand" id="brand" required placeholder="Dior"/>
        </div>

              <!-- Notes -->
        <div class="field">
          <label for="name">Notes </label>
          <input type="text" name="notes" id="notes" required placeholder="bergamot,pepper,ambroxan"/>
          <p>Seperate notes with commas</p>
        </div>

        <!-- Season and Rating Wrapper -->
         <section class="season-rating-wrapper">
        <div class="field">
          <label for="season">Season</label>
          <select name="season" id="season">
            <option value="allyear">All Year</option>
            <option value="summer">Summer</option>
            <option value="spring">Spring</option>
            <option value="fall">Fall</option>
            <option value="Winter">Winter</option>
          </select>
        </div>

        <div class="field">
          <label for="rating">Rating</label>
          <select name="rating" id="rating">
            <option value="1">1 </option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
        </div>
           </section>

        

        <button type="submit">Add fragrance</button>
      </form>
    </section>

    <!-- Fragrances Collection Section -->

    <section class="fragrance-collection-wrapper">
        <h2>My <em>Fragrances</em></h2>
        <input type="text" name="search" id="search" placeholder="Search by name or brand">

        <!-- Display when nothing is found -->
        <p id="error-message" class="empty-container"></p>


            <% if (perfumes.length > 0) { %>
                 <section class="fragrance-collection">
                <% for(const perfume of perfumes) { %>
                <div class="individual-perfume">
                <img src="<%= perfume.image %>" alt="pefume-image"  />
                 <span id="brandName"><%= perfume.brand %></span>  
                 <h3 id="perfume-name"><%= perfume.name %></h3>
               

                <!-- Diplays notes based on their lengrh -->
                 <% if (perfume.notes.length > 0) { %>
                      <% for(const note of perfume.notes) { %>
                        <div class="notes-wrapper">
                            <span class="notes"><%= note %></span>
                        </div>
                        <% } %>
               <% } %>
                <!-- Season and Star Contaier -->
                <section class="season-year-container">
                <span><%= perfume.season %></span>

                <!-- Mapping rating with star -->
                <% const renderStars = (rating) => "⭐".repeat(rating) + "☆".repeat(5 - rating); %>
                <span class="rating"><%= renderStars(perfume.rating) %></span>
                </section>

                <!-- Button wrapper -->
                 <section class="button-wrapper">
                    <a class="btn edit" href="/perfume/<%= perfume._id %>/edit">Edit</a>
                    <button data-perfume-id="<%= perfume._id %>" class="btn delete">Delete</button>
                 </section>
                  </div>
            <% } %>
                 </section>
                 <% } %>

    </section>
       </main>
      <script src="/main.js"></script>
</body>
</html>